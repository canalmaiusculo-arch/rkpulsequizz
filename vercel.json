{
  "version": 2,
  "builds": [
    { "src": "public/**/*", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/va/?", "dest": "/public/va/index.html" },
    { "src": "/va/(.*)", "dest": "/public/va/$1" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/styles.css", "dest": "/public/styles.css" },
    { "src": "/quizz.js", "dest": "/public/quizz.js" },
    { "src": "/tracking.js", "dest": "/public/tracking.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
